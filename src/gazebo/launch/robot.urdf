<?xml version="1.0"?>
<robot name="limo_four_diff" xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:property name="M_PI" value="3.14159"/>
<xacro:property name="base_x_size" value="0.13" />
<xacro:property name="base_y_size" value="0.12" />
<xacro:property name="base_z_size" value="0.1" />
<xacro:property name="wheelbase" value="0.2"/>
<xacro:property name="track" value="0.13"/>
<xacro:property name="wheel_vertical_offset" value="-0.10" />
<xacro:property name="base_mass" value="2.1557"/>
<xacro:property name="wheel_length" value="0.045" />
<xacro:property name="wheel_radius" value="0.045" />

<xacro:property name="wheel_mass" value="0.5" />
<xacro:property name="wheel_ixx" value="0.01055" />
<xacro:property name="wheel_iyy" value="0.00075" />
<xacro:property name="wheel_izz" value="0.01055" />

<link name="base_footprint"/>

<joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="robot/base_link"/>
  <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
</joint>

<link name="robot/base_link">
  <visual>
    <geometry>
      <mesh filename="package://gazebo/meshes/limo_base_decimated.dae" scale="1 1 1"/>
    </geometry>
    <origin xyz="0 0 -0.15" rpy="0 0 1.57" />
  </visual>

  <collision>
    <geometry>
      <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
    </geometry>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </collision>

  <inertial>
    <mass value="${base_mass}"/>
    <origin xyz="0.0 0.0 0.0" />
    <inertia ixx="0.01" ixy="0.0" ixz="0.0"
              iyy="0.01" iyz="0.0"
              izz="0.01" />
  </inertial>
</link>

<xacro:macro name="wheel" params="prefix x y z reflect">

  <link name="robot/${prefix}_wheel">
    <visual>
      <geometry>
        <mesh filename="package://gazebo/meshes/limo_wheel.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <origin xyz="0 ${wheel_length/2} 0" rpy="${M_PI/2} 0 0"/> 
    </collision>

    <inertial>
      <mass value="${wheel_mass}"/>
      <origin xyz="0 0 0" />
      <inertia ixx="${wheel_ixx}" ixy="0" ixz="0"
                iyy="${wheel_iyy}" iyz="0"
                izz="${wheel_izz}"/>
    </inertial>
  </link>

  <joint name="${prefix}_wheel" type="continuous">
    <parent link="robot/base_link"/>
    <child link="${prefix}_wheel"/>
    <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    <axis xyz="0 ${reflect*1} 0"/>
  </joint>

</xacro:macro>

<xacro:wheel prefix="front_left"
              x="${wheelbase/2}"
              y="${track/2}"
              z="${wheel_vertical_offset}"
              reflect="1"/>

<xacro:wheel prefix="front_right"
              x="${wheelbase/2}"
              y="${-track/2}"
              z="${wheel_vertical_offset}"
              reflect="-1"/>

<xacro:wheel prefix="rear_left"
              x="${-wheelbase/2}"
              y="${track/2}"
              z="${wheel_vertical_offset}"
              reflect="1"/>

<xacro:wheel prefix="rear_right"
              x="${-wheelbase/2}"
              y="${-track/2}"
              z="${wheel_vertical_offset}"
              reflect="-1"/>

</robot>